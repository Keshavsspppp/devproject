# ─── DevCollab server configuration ───────────────────────────────
# Copy to .env and edit. Everything has a demo default, so the app
# runs out of the box even with this file untouched.

NODE_ENV=development
PORT=4001
CLIENT_ORIGIN=http://localhost:5173

# DEMO_MODE=true → works with no Mongo/GitHub/AI keys (in-memory store,
# mock AI provider, sample PR data). Set to false once you wire real services.
DEMO_MODE=true

# ── Database ────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/devcollab

# ── Auth / JWT ──────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# ── GitHub OAuth + webhooks (optional) ──────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── AI provider (optional) ─────────────────────────────────────────
# AI_PROVIDER: mock | gemini | groq
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Redis pub/sub (optional, for multi-instance socket scaling) ─────
REDIS_URL=
