# ─── DevCollab Server Environment Variables Example ────────────────────────
# Copy this file to server/.env and adjust values.

NODE_ENV=development
PORT=4001
CLIENT_ORIGIN=http://localhost:5173
DEMO_MODE=true

# Database Configuration (In-memory store fallback when DEMO_MODE=true)
MONGO_URI=mongodb://127.0.0.1:27017/devcollab

# Auth Secrets (Set long high-entropy strings in production)
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# GitHub Integration (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# AI Provider Configuration (Optional)
# AI_PROVIDER: mock | gemini | groq
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Redis pub/sub (Optional, for horizontal socket scaling)
REDIS_URL=
